# Copy to .env for local development only. In AWS, inject these from
# Secrets Manager / SSM Parameter Store into the task environment.
TRIAGE_ENVIRONMENT=development
TRIAGE_AWS_REGION=us-east-1
TRIAGE_ALLOWED_HOSTS=triage.example.com

# WhatsApp Cloud API (Meta App Secret signs X-Hub-Signature-256)
TRIAGE_WHATSAPP_APP_SECRET=
TRIAGE_WHATSAPP_VERIFY_TOKEN=
TRIAGE_WHATSAPP_ACCESS_TOKEN=

# Inbound MTA relay -> POST /v1/webhooks/email
TRIAGE_EMAIL_RELAY_SECRET=

# >= 32 random bytes, e.g. `openssl rand -base64 48`
TRIAGE_PII_HMAC_KEY=

# Claude on Amazon Bedrock (Mantle endpoint). Optional PrivateLink endpoint:
TRIAGE_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
# TRIAGE_BEDROCK_ENDPOINT_URL=https://vpce-xxxx.bedrock-mantle.us-east-1.vpce.amazonaws.com/anthropic

# Supabase Postgres (connect as the triage_backend role; TLS verified)
TRIAGE_DATABASE_URL=postgresql://triage_backend:PASSWORD@db.PROJECT.supabase.co:5432/postgres
TRIAGE_DATABASE_SSL_ROOT_CERT=/etc/ssl/supabase/prod-ca-2021.crt

# Audit trail: S3 bucket created with Object Lock enabled
TRIAGE_AUDIT_BUCKET=
TRIAGE_AUDIT_KMS_KEY_ID=
TRIAGE_AUDIT_RETENTION_DAYS=1827
