{
  "version": 1,
  "cases": [
    {
      "id": "agent_line_math",
      "doc_case": "inv_line_math_error",
      "description": "Outlet line billed at 540 instead of 10 x 45 = 450.",
      "expected": {
        "verdicts": [
          "dispute"
        ],
        "disputed_amount": "90.00",
        "required_tools": [
          "line_total",
          "overcharge"
        ],
        "optional_tools": [
          "lookup_vendor_history",
          "find_purchase_orders"
        ],
        "forbidden_verdicts": [
          "approve"
        ]
      },
      "reference_turns": [
        {
          "text": "Checking purchase orders.",
          "tool_calls": [
            {
              "id": "c1",
              "name": "find_purchase_orders",
              "arguments": {
                "vendor_name": "Apex Electrical Services"
              }
            }
          ]
        },
        {
          "text": "Recomputing.",
          "tool_calls": [
            {
              "id": "c2",
              "name": "line_total",
              "arguments": {
                "quantity": "10",
                "unit_price": "45.00"
              }
            },
            {
              "id": "c3",
              "name": "overcharge",
              "arguments": {
                "billed": "540.00",
                "correct": "450.00"
              }
            }
          ]
        },
        {
          "text": "Submitting.",
          "tool_calls": [
            {
              "id": "c4",
              "name": "submit_resolution",
              "arguments": {
                "verdict": "dispute",
                "disputed_amount": "90.00",
                "summary": "Outlet replacement is billed at 540.00 but 10 x 45.00 = 450.00; dispute 90.00.",
                "evidence": [
                  "line_total returned 450.00",
                  "overcharge returned 90.00",
                  "PO-2024-118 approves 539.00"
                ],
                "draft_email": "Hello Apex Electrical Services,\n\nInvoice 7781 bills the outlet replacement at 540.00, but 10 x 45.00 is 450.00. Please send a corrected invoice reducing it by 90.00.\n\nThank you."
              }
            }
          ]
        }
      ]
    },
