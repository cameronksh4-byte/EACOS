# =============================================================================
# Tier 1 IT Help Desk Agent: deployment configuration (ONE file per client)
#
#   cp deploy/deploy.env.example deploy/acme-corp.env   # never commit the copy
#   chmod 600 deploy/acme-corp.env
#   python deploy/render_config.py --generate-secrets   # paste the output below
#   deploy/deploy.sh deploy/acme-corp.env --plan        # dry run, changes nothing
#   deploy/deploy.sh deploy/acme-corp.env               # deploy
#
# Format: KEY=value, one per line. Lines starting with # are ignored.
# Values are read as plain text; nothing in this file is ever executed.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED FOR EVERY DEPLOYMENT
# -----------------------------------------------------------------------------

# AWS region to deploy into (needs Graviton Fargate; most regions have it).
AWS_REGION=us-east-1

# Short id for this client: 2-24 lowercase letters, digits, dashes. Names every AWS resource.
CLIENT_SLUG=acme-corp

# Public HTTPS hostname for the agent (Slack/Jira/n8n call it). Must be a domain you control.
PUBLIC_HOSTNAME=helpdesk.acme.com

# TLS: EITHER give the Route 53 hosted zone for that domain (certificate + DNS are automatic) ...
ROUTE53_ZONE_ID=
# ... OR an existing, already-issued ACM certificate for PUBLIC_HOSTNAME in AWS_REGION.
ACM_CERTIFICATE_ARN=

# Commercial tier: TIER_0_INCENTIVE (free trial) | TIER_1_PRODUCTION | TIER_2_MANAGED_OPS
SERVICE_TIER=TIER_0_INCENTIVE
# Tier 0 trial end (YYYY-MM-DD). After it, tickets go straight to humans. "none" = no end.
TRIAL_EXPIRES_ON=2026-12-31

# Hard monthly AI spend cap per tenant, USD.
MONTHLY_TOKEN_BUDGET_USD=25

# Supabase project (Project Settings > API): URL and the service_role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
# Postgres connection string, used once to apply the schema (Project Settings > Database >
# Connection string > "Session pooler" or direct, port 5432). Leave empty to apply
# supabase/migrations/001_init_schema.sql by hand in the SQL editor.
SUPABASE_DB_URL=

# Voyage AI key for embeddings (https://dash.voyageai.com).
VOYAGE_API_KEY=

# Claude: "anthropic" (needs ANTHROPIC_API_KEY) or "bedrock" (uses the ECS task role;
# enable Claude Haiku 5.5 + Sonnet 5.5 under Bedrock > Model access first).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Shared secret for /v1/* API callers (and n8n's weekly-report call). >= 24 random chars.
WEBHOOK_SECRET=

# Where technicians get alerts (outages, escalations). Tier 0 needs one of:
#   a Slack channel (bot token below + channel ID) ...
SLACK_BOT_TOKEN=
SLACK_ESCALATION_CHANNEL=
#   ... or a signed n8n notification webhook (see section 3).

# -----------------------------------------------------------------------------
# 2. KNOWLEDGE TO LOAD (optional; the deploy script loads these after deploying)
# -----------------------------------------------------------------------------

# Folder of SOP Markdown files (see ingest/sample_sops for the format).
SOP_DIR=ingest/sample_sops
# Tier 1 data: application/hardware catalog and (for IDENTITY_PROVIDER=directory_cache) users.
CATALOG_CSV=
DIRECTORY_CSV=

# -----------------------------------------------------------------------------
# 3. CHAT & TICKETING INTEGRATIONS (optional)
# -----------------------------------------------------------------------------

# Slack app (integrations/slack/app-manifest.yaml): Basic Information > Signing Secret.
SLACK_SIGNING_SECRET=
# Microsoft Teams outgoing webhook security token, and an incoming webhook for follow-ups.
TEAMS_OUTGOING_WEBHOOK_SECRET=
TEAMS_INCOMING_WEBHOOK_URL=
# Jira Cloud: webhook on "Issue created" with this secret, plus an API token for comments.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 4. TIER 1 (TIER_1_PRODUCTION): approvals via n8n, identity/MDM context
#    Running n8n on your own machine? Read integrations/n8n/LOCAL_N8N.md first:
#    the agent runs in AWS, so it needs a public HTTPS URL for n8n's /webhook/ paths.
# -----------------------------------------------------------------------------

# Public HTTPS base URL that reaches your n8n's webhooks (for a local n8n: your tunnel,
# e.g. https://n8n-hooks.acme.com). The agent's two n8n webhook URLs are derived from it:
#   <N8N_PUBLIC_URL>/webhook/helpdesk-approvals and <N8N_PUBLIC_URL>/webhook/helpdesk-notify
# (set N8N_APPROVAL_WEBHOOK_URL / N8N_NOTIFY_WEBHOOK_URL only to override them).
N8N_PUBLIC_URL=
N8N_APPROVAL_WEBHOOK_URL=
N8N_NOTIFY_WEBHOOK_URL=
# Signing secrets shared with n8n (generate them). deploy.sh writes the matching n8n env
# file to deploy/<client>.n8n.env every run, so you never copy them by hand.
N8N_OUTBOUND_SIGNING_SECRET=
N8N_CALLBACK_SECRET=
# Optional: let the deploy script import + publish the workflows through the n8n API. It runs on
# this machine, so a local n8n works: N8N_API_URL=http://localhost:5678 (Settings > n8n API > key).
N8N_API_URL=
N8N_API_KEY=
# Slack channel IDs n8n posts to (default: SLACK_ESCALATION_CHANNEL).
N8N_SLACK_ALERT_CHANNEL=
N8N_SLACK_SOP_REVIEW_CHANNEL=
N8N_SLACK_EXEC_CHANNEL=
# How n8n grants approved items: entra | okta | none (none = alert a technician to do it).
# Default follows IDENTITY_PROVIDER. Entra provisioning needs GroupMember.ReadWrite.All; use a
# separate app registration for it if you like (else the GRAPH_* values below are reused).
N8N_PROVISIONING_PROVIDER=
N8N_GRAPH_CLIENT_ID=
N8N_GRAPH_CLIENT_SECRET=

# Identity provider: directory_cache (DIRECTORY_CSV) | microsoft_graph | okta
IDENTITY_PROVIDER=directory_cache
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
OKTA_DOMAIN=
OKTA_API_TOKEN=
# Approver for catalog items with approver_role = it_manager.
IT_MANAGER_EMAIL=

# -----------------------------------------------------------------------------
# 5. OPTIONAL TUNING
# -----------------------------------------------------------------------------

HELPDESK_NAME=IT Help Desk
TIER2_CONTACT_HINT=a Tier 2 technician
# Extra tenants served by this deployment (comma-separated), and per-tenant budgets (JSON).
ALLOWED_TENANT_IDS=
TENANT_BUDGET_OVERRIDES_USD=
# Kill switch (comma-separated features): e.g. outage_detection,screenshot_vision
DISABLED_FEATURES=
# Email for CloudWatch alarms (confirm the SNS email AWS sends).
ALARM_EMAIL=
# AWS WAF in front of the load balancer (~$6/month + requests).
ENABLE_WAF=false
DESIRED_COUNT=1
MAX_COUNT=4
# Narrow who can reach the load balancer (comma-separated CIDRs). Default: anyone.
ALLOWED_INGRESS_CIDRS=
# Bedrock only: restrict the IAM grant to specific model ARNs (comma-separated).
BEDROCK_MODEL_ARNS=
