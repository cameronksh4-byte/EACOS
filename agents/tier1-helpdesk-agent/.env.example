# ---------------------------------------------------------------------------
# Tier 1 IT Help Desk Agent: local configuration (copy to .env)
# In AWS these come from Terraform: plain values as environment variables,
# secrets from Secrets Manager.
# ---------------------------------------------------------------------------

# --- Commercial tier ---------------------------------------------------------
SERVICE_TIER=TIER_0_INCENTIVE        # TIER_0_INCENTIVE | TIER_1_PRODUCTION | TIER_2_MANAGED_OPS
# TRIAL_EXPIRES_ON=2026-12-31        # Tier 0: after this date tickets go straight to humans
# DISABLED_FEATURES=                 # kill switch, comma-separated, e.g. outage_detection,screenshot_vision

# --- Tenancy -----------------------------------------------------------------
TENANT_ID=acme-corp
# ALLOWED_TENANT_IDS=globex,initech  # extra tenants served by this deployment
HELPDESK_NAME=Acme IT Help Desk
TIER2_CONTACT_HINT=a Tier 2 technician

# --- Always required ---------------------------------------------------------
WEBHOOK_SECRET=change-me             # x-webhook-secret for /v1/* API callers
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
VOYAGE_API_KEY=
MONTHLY_TOKEN_BUDGET_USD=25.00
# TENANT_BUDGET_OVERRIDES_USD={"globex": 100}

# --- Model provider ----------------------------------------------------------
LLM_PROVIDER=anthropic               # anthropic | bedrock
ANTHROPIC_API_KEY=                   # anthropic only (LLM_API_KEY also accepted)
# AWS_REGION=us-east-1               # bedrock: credentials come from the AWS chain / ECS task role
# TRIAGE_MODEL=claude-haiku-5-5
# VISION_MODEL=claude-haiku-5-5
# REASONING_MODEL=claude-sonnet-5-5
# FLYWHEEL_MODEL=claude-sonnet-5-5

# --- Tier 2 notification channel (required while outage detection is on) -----
# Either signed n8n (preferred) ...
# N8N_NOTIFY_WEBHOOK_URL=https://n8n.example.com/webhook/helpdesk-notify
# N8N_OUTBOUND_SIGNING_SECRET=
# ... or a Slack channel:
SLACK_BOT_TOKEN=
SLACK_ESCALATION_CHANNEL=

# --- Chat integrations (optional) --------------------------------------------
SLACK_SIGNING_SECRET=
TEAMS_OUTGOING_WEBHOOK_SECRET=
TEAMS_INCOMING_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
# ATTACHMENT_ALLOWED_HOSTS=files.slack.com,atlassian.net,graph.microsoft.com,zendesk.com

# --- Tier 1: identity / MDM context ------------------------------------------
# IDENTITY_PROVIDER=directory_cache  # directory_cache | microsoft_graph | okta
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# OKTA_DOMAIN=acme.okta.com
# OKTA_API_TOKEN=

# --- Tier 1: n8n approvals -----------------------------------------------------
# PUBLIC_BASE_URL=https://helpdesk.acme.com   # where n8n calls back
# N8N_APPROVAL_WEBHOOK_URL=https://n8n.example.com/webhook/helpdesk-approvals
# N8N_OUTBOUND_SIGNING_SECRET=                # we sign requests to n8n
# N8N_CALLBACK_SECRET=                        # n8n signs callbacks to us
# IT_MANAGER_EMAIL=it-lead@acme.com           # approver for approver_role = it_manager

# --- Tier 2: flywheel & reports (also needs N8N_NOTIFY_WEBHOOK_URL + N8N_CALLBACK_SECRET)
# FLYWHEEL_GAP_SIMILARITY_THRESHOLD=0.82
