# Copy to .env and fill in. Never commit .env.

# Which extraction backend to use:
#   heuristic  - 100% offline rule-based extractor (default, no data leaves the machine)
#   local      - any OpenAI-compatible local server (Ollama, LM Studio, vLLM)
#   openai     - OpenAI API (text is sanitized first)
#   anthropic  - Anthropic API (text is sanitized first)
AUDITGATE_PROVIDER=heuristic

# Local OpenAI-compatible server (e.g. `ollama serve` then `ollama pull llama3.1`)
AUDITGATE_LOCAL_BASE_URL=http://localhost:11434/v1
AUDITGATE_LOCAL_MODEL=llama3.1

# Hosted providers (only used when AUDITGATE_PROVIDER is openai/anthropic)
OPENAI_API_KEY=
AUDITGATE_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
AUDITGATE_ANTHROPIC_MODEL=claude-sonnet-5-5

# Sanitizer
# Optional spaCy NER model for person-name detection: uv run python -m spacy download en_core_web_sm
AUDITGATE_SPACY_MODEL=en_core_web_sm
AUDITGATE_REDACT_ORGS=false
# Comma-separated extra terms to always redact (client names, project code names...)
AUDITGATE_DENY_TERMS=

# Instructor retry budget for schema-validation failures
AUDITGATE_MAX_RETRIES=2
